{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title | default site.Title }} - 해아림한의원 자율신경클리닉</title>
    <link>{{ .Permalink }}</link>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    <description>{{ .Description | default site.Params.hugoblox.identity.description | plainify }} - 자율신경실조증 최신 치료 칼럼 및 임상 FAQ</description>
    <generator>HugoBlox Kit &amp; Healim AEO Engine</generator>
    <language>ko</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <image>
      <url>https://healim-autonomic.com/media/sharing.jpg</url>
      <title>{{ .Title | default site.Title }}</title>
      <link>{{ .Permalink }}</link>
    </image>

    {{/* 1. Static Pages */}}
    {{- range site.Pages -}}
      {{- if and (not .IsHome) (ne .Params.private true) (not (in .RelPermalink "/admin/")) (not (in .RelPermalink "/login/")) (not (in .RelPermalink "/register/")) (not (in .RelPermalink "/site_join_type_choice/")) (not (in .RelPermalink "/tags/")) (not (in .RelPermalink "/categories/")) (not (in .RelPermalink "/authors/")) -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ if not .Date.IsZero }}{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ else }}{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ end }}</pubDate>
      <author>healim@healim.com (해아림한의원 전문의료진)</author>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ .Description | default .Summary | plainify }}</description>
      <category>자율신경실조증</category>
    </item>
      {{- end -}}
    {{- end -}}

    {{/* 2. Auto-Published Clinical Columns (AEO / GEO / SEO) */}}
    {{- with site.Data.healim_community_hub -}}
      {{- range .columns -}}
    <item>
      <title>[칼럼] {{ .title }}</title>
      <link>https://healim-autonomic.com/community/#columns</link>
      <pubDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <author>healim@healim.com (해아림한의원 전문의료진)</author>
      <guid isPermaLink="false">https://healim-autonomic.com/community/#col-{{ .id }}</guid>
      <description>{{ .summary | default .title | plainify }}</description>
      <category>자율신경실조증 칼럼</category>
    </item>
      {{- end -}}

      {{/* 3. Auto-Published Clinical FAQs (AEO / GEO / SEO) */}}
      {{- range .faq -}}
    <item>
      <title>[FAQ] {{ .title }}</title>
      <link>https://healim-autonomic.com/community/#faq</link>
      <pubDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <author>healim@healim.com (해아림한의원 전문의료진)</author>
      <guid isPermaLink="false">https://healim-autonomic.com/community/#faq-{{ .id }}</guid>
      <description>{{ .summary | default .title | plainify }}</description>
      <category>자율신경실조증 FAQ</category>
    </item>
      {{- end -}}
    {{- end -}}

  </channel>
</rss>