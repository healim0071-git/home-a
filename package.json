{
    "name":  "hugo-blox-starter",
    "version":  "1.0.0",
    "private":  true,
    "packageManager":  "pnpm@10.14.0",
    "description":  "Starter template for Hugo Blox with Tailwind CSS v4",
    "scripts":  {
                    "dev":  "hugo server --disableFastRender",
                    "build":  "node scripts/sync_seo_geo_pipeline.js \u0026\u0026 pnpm run pagefind",
                    "pagefind":  "pagefind --site public 2\u003e/dev/null || true",
                    "doc:update":  "node scripts/update_docs.js",
                    "seo:sync":  "node scripts/sync_seo_geo_pipeline.js"
                },
    "dependencies":  {
                         "@tailwindcss/cli":  "^4.1.12",
                         "@tailwindcss/typography":  "^0.5.10",
                         "pagefind":  "^1.4.0",
                         "preact":  "^10.27.2",
                         "tailwindcss":  "^4.1.12"
                     }
}